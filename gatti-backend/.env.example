# Copie este arquivo para .env e substitua todos os valores CHANGE_ME.
NODE_ENV=development
APP_NAME=GATTI Backend
APP_PORT=3001
APP_URL=http://localhost:3001
API_PREFIX=api/v1

# Database — use uma base de homologação, nunca dados de produção.
DATABASE_URL=postgresql://gatti:CHANGE_ME_DATABASE_PASSWORD@localhost:5432/gatti_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=gatti
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_NAME=gatti_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT — gere segredos longos e aleatórios para cada ambiente.
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_REFRESH_EXPIRATION=7d

# Administrador inicial — obrigatório apenas para `npm run prisma:seed`.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_FIRST_NAME=
INITIAL_ADMIN_LAST_NAME=

# Zabbix — deixe em branco até que a integração e o mapeamento de itens sejam definidos.
ZABBIX_API_URL=
ZABBIX_API_USER=
ZABBIX_API_PASSWORD=
ZABBIX_SYNC_INTERVAL=300000

# Jobs Configuration
BULLMQ_QUEUE_PREFIX=gatti:
SYNC_PRINTERS_INTERVAL=300000
SYNC_METRICS_INTERVAL=60000
CALCULATE_CONSUMPTION_INTERVAL=3600000
DETECT_TONER_CHANGE_INTERVAL=300000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Security
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Relatórios — configure somente quando a geração e o armazenamento forem ativados.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
