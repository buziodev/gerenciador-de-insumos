# Application
NODE_ENV=development
APP_NAME=GATTI Backend
APP_PORT=3000
APP_URL=http://localhost:3000
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://gatti:gatti123@postgres:5432/gatti_db
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=gatti
DATABASE_PASSWORD=gatti123
DATABASE_NAME=gatti_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRATION=7d

# Zabbix Integration
ZABBIX_API_URL=http://zabbix-server/api_jsonrpc.php
ZABBIX_API_USER=Admin
ZABBIX_API_PASSWORD=zabbix
ZABBIX_SYNC_INTERVAL=300000

# Jobs Configuration
BULLMQ_QUEUE_PREFIX=gatti:
SYNC_PRINTERS_INTERVAL=300000
SYNC_METRICS_INTERVAL=60000
CALCULATE_CONSUMPTION_INTERVAL=3600000
DETECT_TONER_CHANGE_INTERVAL=300000

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Security
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email (future)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@gatti.com

# AWS S3 (for reports)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=gatti-reports
